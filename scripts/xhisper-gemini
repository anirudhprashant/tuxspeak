#!/bin/bash

# xhisper-gemini - Record speech → transcribe → AI polish → type at cursor
# Fork of xhisper with Gemini text polishing

[ -f "$HOME/.env" ] && source "$HOME/.env"

if [ -z "$GEMINI_API_KEY" ]; then
  echo "Error: GEMINI_API_KEY not set. Add it to ~/.env:" >&2
  echo '  GEMINI_API_KEY=your_gemini_api_key_here' >&2
  exit 1
fi
API_KEY="$GEMINI_API_KEY"

RECORDING="/tmp/xhisper-gemini.wav"
LOGFILE="/tmp/xhisper-gemini.log"
HISTORY_FILE="${XDG_DATA_HOME:-$HOME/.local/share}/xhisper/history.txt"
PROCESS_PATTERN="pw-record.*$RECORDING"
INDICATOR="/tmp/xhisper-gemini.indicator"
INDICATOR_COUNT="/tmp/xhisper-gemini.indicator-count"  # marker characters typed so far
RECORDING_MARK="(recording...)"
MARKER_DELAY=0.01      # seconds between marker characters, so it types in rather than popping in
BACKSPACE_DELAY=0.005  # seconds between backspaces when the marker is removed

# Ensure history directory and file exist
mkdir -p "$(dirname "$HISTORY_FILE")"
touch "$HISTORY_FILE"

# Default configuration
long_recording_threshold=1000
transcription_prompt=""
silence_threshold=-50
silence_percentage=95
non_ascii_initial_delay=0.15
non_ascii_default_delay=0.025

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/xhisper/xhisperrc"
if [ -f "$CONFIG_FILE" ]; then
  while IFS=: read -r key value || [ -n "$key" ]; do
    [[ "$key" =~ ^[[:space:]]*# ]] && continue
    [[ -z "$key" ]] && continue
    key=$(echo "$key" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    value=$(echo "$value" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^"//;s/"$//')
    case "$key" in
      long-recording-threshold) long_recording_threshold="$value" ;;
      transcription-prompt) transcription_prompt="$value" ;;
      silence-threshold) silence_threshold="$value" ;;
      silence-percentage) silence_percentage="$value" ;;
      non-ascii-initial-delay) non_ascii_initial_delay="$value" ;;
      non-ascii-default-delay) non_ascii_default_delay="$value" ;;
    esac
  done < "$CONFIG_FILE"
fi

# Auto-start daemon if not running
if ! pgrep -x xhispertoold > /dev/null; then
    echo "DEBUG: Starting xhispertoold daemon" >> "$LOGFILE"
    xhispertoold 2>> /tmp/xhispertoold.log &
    sleep 1  # Give daemon time to start

    if ! pgrep -x xhispertoold > /dev/null; then
        echo "DEBUG: Failed to start xhispertoold daemon" >> "$LOGFILE"
        echo "Error: Failed to start xhispertoold daemon" >&2
        echo "Check /tmp/xhispertoold.log for details" >&2
        exit 1
    fi
    echo "DEBUG: xhispertoold started successfully" >> "$LOGFILE"
fi

# Ensure xhispertool is installed
if ! command -v xhispertool &> /dev/null; then
  echo "Error: xhispertool not found. Run 'sudo make install' in xhisper directory." >&2
  exit 1
fi

# Detect clipboard tool (test if it actually works, not just if it exists)
if command -v xclip &> /dev/null; then
  CLIP_COPY="xclip -selection clipboard"
elif command -v wl-copy &> /dev/null && echo "test" | wl-copy 2>/dev/null; then
  CLIP_COPY="wl-copy"
else
  echo "Error: No clipboard tool found. Install xclip or wl-clipboard." >&2
  exit 1
fi

# One call per run; falls back to one call per character for an xhispertool
# build that only accepts a single character.
type_run() {
  xhispertool type "$1" 2>/dev/null && return 0
  local i
  for ((i=0; i<${#1}; i++)); do xhispertool type "${1:$i:1}"; done
}

# Hold mode: Alt is down while the marker is typed, and Alt+key would be wrong
# in terminals and apps. Hyprland's send_shortcut sends each key with explicit
# (empty) modifiers instead, so the held Alt is ignored.
type_marker_hyprland() {
  command -v hyprctl &> /dev/null || return 1
  local k n=0
  for k in SHIFT:9 :r :e :c :o :r :d :i :n :g :period :period :period SHIFT:0; do
    [ -f "$INDICATOR" ] || return 0   # recording already stopped
    hyprctl dispatch "hl.dsp.send_shortcut({mods=\"${k%%:*}\", key=\"${k##*:}\"})" &> /dev/null || return 1
    echo $((++n)) > "$INDICATOR_COUNT"
    sleep "$MARKER_DELAY"
  done
}

# Toggle mode: same pacing through the daemon.
type_marker_slow() {
  local i
  for ((i=0; i<${#1}; i++)); do
    [ -f "$INDICATOR" ] || return 0   # recording already stopped
    xhispertool type "${1:$i:1}"
    echo $((i+1)) > "$INDICATOR_COUNT"
    sleep "$MARKER_DELAY"
  done
}

# Type text: runs of printable ASCII go to the daemon in one call,
# anything else (unicode, newlines) goes through the clipboard.
paste() {
  local text="$1" ch code run=""
  echo "DEBUG: Pasting text: [$text]" >> "$LOGFILE"
  while IFS= read -r -N1 ch; do
    printf -v code '%d' "'$ch"
    if [[ $code -ge 32 && $code -le 126 ]]; then
      run+="$ch"
    else
      [ -n "$run" ] && type_run "$run" && run=""
      echo -n "$ch" | $CLIP_COPY 2>/dev/null
      xhispertool paste
      sleep "$non_ascii_default_delay"
    fi
  done < <(printf '%s' "$text")
  [ -n "$run" ] && type_run "$run"
}

# Recording length in seconds (16 kHz mono s16 = 32000 bytes/s)
get_duration() {
  echo $(( $(stat -c %s "$1" 2>/dev/null || echo 0) / 32000 ))
}

is_silent() {
  local max_vol
  max_vol=$(ffmpeg -i "$1" -af volumedetect -f null /dev/null 2>&1 | awk '/max_volume/ {print $5}')
  [ -n "$max_vol" ] && awk -v v="$max_vol" -v t="$silence_threshold" 'BEGIN { exit !(v < t) }'
}

save_to_history() {
  local text="$1"
  local raw_transcription="$2"
  local timestamp=$(date '+%Y-%m-%d %H:%M:%S')

  {
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "$timestamp"
    echo ""
    echo "Polished:"
    echo "$text"
    echo ""
    echo "Raw transcription:"
    echo "$raw_transcription"
    echo ""
  } >> "$HISTORY_FILE"
}

transcribe() {
  local recording="$1"
  local model="whisper-large-v3-turbo"
  [ "$(get_duration "$recording")" -gt "$long_recording_threshold" ] && model="whisper-large-v3"

  curl -s -X POST "https://api.groq.com/openai/v1/audio/transcriptions" \
    -H "Authorization: Bearer $GROQ_API_KEY" \
    -H "Content-Type: multipart/form-data" \
    -F "file=@$recording" \
    -F "model=$model" \
    -F "prompt=$transcription_prompt" \
    | jq -r '.text // empty' | sed 's/^ //'
}

polish_prompt() {
  printf '%s\n\n%s' "Fix any obvious spelling, grammar, or transcription errors in this dictated text. Do NOT rephrase, restructure sentences, or change the tone. Preserve the original wording as much as possible. Only fix things that are clearly wrong. Return ONLY the corrected text, no explanations:" "$1"
}

clean_polish() {
  sed -e 's/^```\|```$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

# Fastest option: gpt-oss-20b on Groq (same key as transcription)
polish_with_groq() {
  local body response
  body=$(jq -n --arg t "$(polish_prompt "$1")" \
    '{model: "openai/gpt-oss-20b", reasoning_effort: "low", max_completion_tokens: 2048, messages: [{role: "user", content: $t}]}')

  response=$(curl -s --max-time 8 -X POST "https://api.groq.com/openai/v1/chat/completions" \
    -H "Authorization: Bearer $GROQ_API_KEY" \
    -H "Content-Type: application/json" \
    -d "$body")

  echo "DEBUG: Groq polish response: $response" >> "$LOGFILE"
  echo "$response" | jq -r '.choices[0].message.content // empty' | clean_polish
}

polish_with_gemini() {
  local body response
  body=$(jq -n --arg t "$(polish_prompt "$1")" '{contents: [{parts: [{text: $t}]}]}')

  response=$(curl -s --max-time 10 -X POST \
    "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent" \
    -H "x-goog-api-key: $API_KEY" \
    -H "Content-Type: application/json" \
    -d "$body")

  echo "DEBUG: Gemini API response: $response" >> "$LOGFILE"
  echo "$response" | jq -r '.candidates[0].content.parts[0].text // empty' | clean_polish
}

polish() {
  local out
  out=$(polish_with_groq "$1")
  [ -z "$out" ] && out=$(polish_with_gemini "$1")
  echo "$out"
}

# Main

echo "DEBUG: xhisper-gemini started at $(date)" >> "$LOGFILE"

RECORDING_PID=$(pgrep -f "$PROCESS_PATTERN" | head -1)
if [ -n "$RECORDING_PID" ]; then
  # Stop recording and wait for pw-record to finish writing the file
  echo "DEBUG: Stopping recording (PID: $RECORDING_PID)" >> "$LOGFILE"
  pkill -f "$PROCESS_PATTERN"
  for _ in $(seq 50); do pgrep -f "$PROCESS_PATTERN" > /dev/null || break; sleep 0.02; done

  # Remove the "(recording...)" marker once Alt is surely released. The typer
  # stops when the indicator file goes, so wait for it, then delete exactly
  # what was typed.
  if [ -f "$INDICATOR" ]; then
    rm -f "$INDICATOR"
    (
      sleep 0.2
      n=$(cat "$INDICATOR_COUNT" 2>/dev/null || echo 0)
      for ((i=0; i<n; i++)); do xhispertool backspace; sleep "$BACKSPACE_DELAY"; done
      rm -f "$INDICATOR_COUNT"
    ) &
    DELETE_PID=$!
  fi

  # Silence check runs alongside the transcription request
  TMP_OUT=$(mktemp)
  transcribe "$RECORDING" > "$TMP_OUT" &
  TRANSCRIBE_PID=$!
  if is_silent "$RECORDING"; then
    kill "$TRANSCRIBE_PID" 2>/dev/null
    [ -n "$DELETE_PID" ] && wait "$DELETE_PID"
    rm -f "$TMP_OUT" "$RECORDING"
    exit 0
  fi
  wait "$TRANSCRIBE_PID"
  TRANSCRIPTION=$(<"$TMP_OUT")
  [ -n "$DELETE_PID" ] && wait "$DELETE_PID"
  rm -f "$TMP_OUT"
  echo "DEBUG: Raw transcription: [$TRANSCRIPTION]" >> "$LOGFILE"

  if [ -z "$TRANSCRIPTION" ] || [ "$TRANSCRIPTION" = "null" ]; then
    rm -f "$RECORDING"
    exit 0
  fi

  POLISHED=$(polish "$TRANSCRIPTION")
  echo "DEBUG: Polished response: [$POLISHED]" >> "$LOGFILE"

  # Clean up leading artifacts
  POLISHED=$(echo "$POLISHED" | sed -e 's/^[([{]*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
  echo "DEBUG: After cleanup: [$POLISHED]" >> "$LOGFILE"

  if [ -n "$POLISHED" ] && [ "$POLISHED" != "null" ]; then
    paste "$POLISHED"
    save_to_history "$POLISHED" "$TRANSCRIPTION"
  else
    # Fallback to raw transcription if polishing fails
    TRANSCRIPTION=$(echo "$TRANSCRIPTION" | sed -e 's/^[([{]*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    paste "$TRANSCRIPTION"
    save_to_history "$TRANSCRIPTION" "(polishing failed)"
  fi

  rm -f "$RECORDING"
else
  # Start recording
  echo "DEBUG: Starting recording" >> "$LOGFILE"
  pw-record --channels=1 --rate=16000 "$RECORDING" &
  PW_PID=$!
  # Toggle mode waits briefly for Alt+Space to be released. In hold mode Alt
  # stays down for the whole recording, so the marker goes through Hyprland.
  [ -z "$XHISPER_PTT" ] && sleep 0.25
  if kill -0 "$PW_PID" 2>/dev/null; then
    echo 0 > "$INDICATOR_COUNT"
    touch "$INDICATOR"
    if [ -n "$XHISPER_PTT" ]; then
      type_marker_hyprland || type_marker_slow "$RECORDING_MARK"
    else
      type_marker_slow "$RECORDING_MARK"
    fi
  fi
  wait "$PW_PID"
fi

echo "DEBUG: xhisper-gemini ended at $(date)" >> "$LOGFILE"
